{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "x-xp",
	"version": "0.2.0",
	"identifier": "com.involvex.x-xp",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "x-xp",
				"width": 1200,
				"height": 800,
				"minWidth": 800,
				"minHeight": 500
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": {
					"allow": [
						"$HOME/**",
						"$PUBLIC/**",
						"$DOCUMENT/**",
						"$DOWNLOAD/**",
						"$PICTURE/**",
						"$DESKTOP/**",
						"$VIDEO/**",
						"$AUDIO/**",
						"**"
					]
				}
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": ["scripts/install-backup.ps1"],
		"windows": {
			"wix": {
				"fragmentPaths": ["wix/context-menu.wxs", "wix/default-handler.wxs"],
				"componentRefs": [
					"ExplorerContextMenuComponent",
					"ExplorerDefaultHandlerComponent",
					"ExplorerAppPathsComponent"
				]
			}
		}
	}
}
