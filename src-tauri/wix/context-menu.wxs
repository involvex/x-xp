<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <DirectoryRef Id="TARGETDIR">
            <Component Id="ExplorerContextMenuComponent" Guid="com.involvex.x-xp">
                <RegistryKey Root="HKCR" Key="Directory\shell\x-xp">
                    <RegistryValue Type="string" Value="Mit x-xp öffnen" KeyPath="yes" />
                    <RegistryValue Type="string" Name="Icon" Value="[INSTALLDIR]x-xp.exe,0" />
                </RegistryKey>
                <RegistryKey Root="HKCR" Key="Directory\shell\x-xp\command">
                    <RegistryValue Type="string" Value="&quot;[INSTALLDIR]VoidFS.exe&quot; &quot;%1&quot;" />
                </RegistryKey>
            </Component>
        </DirectoryRef>
    </Fragment>
</Wix>
